"""Sample-independent creation of the pipeline's software environments."""

from pathlib import Path
import sys


PIPELINE_ROOT = Path(workflow.basedir).parent.resolve()
if str(PIPELINE_ROOT) not in sys.path:
    sys.path.insert(0, str(PIPELINE_ROOT))

from site_config import configure as configure_site


SITE = configure_site(config)
if SITE.source is not None:
    envvars:
        "SHORT_READ_SITE_CONFIG"


ENVIRONMENT_FILES = {
    "preprocess": PIPELINE_ROOT / "envs/preprocess.yaml",
    "align_fused": PIPELINE_ROOT / "envs/align_fused.yaml",
    "qc_fused": PIPELINE_ROOT / "envs/qc_fused.yaml",
    "kmc": PIPELINE_ROOT / "envs/kmc.yaml",
    "kraken": PIPELINE_ROOT / "envs/kraken.yaml",
    "mosdepth": PIPELINE_ROOT / "envs/mosdepth.yaml",
    "capture_kit_finder": PIPELINE_ROOT / "envs/capture_kit_finder.yaml",
    "vcf_handling": PIPELINE_ROOT / "envs/vcf_handling.yaml",
    "annovar": PIPELINE_ROOT / "envs/annovar.yaml",
    "pca": PIPELINE_ROOT / "envs/PCA.yaml",
    "gatk_gcnv": PIPELINE_ROOT / "envs/gatk_gcnv.yaml",
    "delly": PIPELINE_ROOT / "envs/delly.yaml",
    "picard": PIPELINE_ROOT / "envs/picard.yaml",
}

CORE_ENVIRONMENTS = {
    "preprocess",
    "align_fused",
    "qc_fused",
    "kmc",
    "kraken",
    "mosdepth",
    "capture_kit_finder",
    "vcf_handling",
}


def configured_groups():
    raw = config.get("deployment_groups", "")
    if isinstance(raw, str):
        return {value.strip().lower() for value in raw.split(",") if value.strip()}
    return {str(value).strip().lower() for value in raw if str(value).strip()}


def selected_environments():
    selected = set(CORE_ENVIRONMENTS)
    endpoint = str(config.get("END_POINT", "gVCF")).strip().lower()
    groups = configured_groups()
    if endpoint in {"genotype", "genotyper", "combine", "vqsr", "vcf"}:
        selected.add("annovar")
    if endpoint in {"pca"} or "pca" in groups:
        selected.add("pca")
    if endpoint in {"gcnv", "cnv"} or "gcnv" in groups:
        selected.update({"gatk_gcnv", "pca"})
    if endpoint in {"sv", "delly"} or "delly" in groups:
        selected.add("delly")
    if "legacy" in groups:
        selected.add("picard")
    if "all" in groups:
        selected.update(ENVIRONMENT_FILES)
    unknown = groups - {"pca", "gcnv", "delly", "legacy", "all"}
    if unknown:
        raise ValueError(
            "unknown deployment_groups value(s): " + ", ".join(sorted(unknown))
        )
    return sorted(selected)


SELECTED_ENVIRONMENTS = selected_environments()


rule deploy_environments:
    input:
        expand(".deployment/environments/{environment}.ready",
               environment=SELECTED_ENVIRONMENTS)
    default_target: True


rule conda_environment:
    output:
        touch(".deployment/environments/{environment}.ready")
    wildcard_constraints:
        environment="|".join(sorted(ENVIRONMENT_FILES))
    conda:
        lambda wildcards: str(ENVIRONMENT_FILES[wildcards.environment])
    shell:
        "true"
